{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "./dist",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "./src",
		"strict": true,   
		"moduleResolution": "Node16",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node", "vscode"],
		"jsx": "preserve"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", ".vscode-test"]
}
