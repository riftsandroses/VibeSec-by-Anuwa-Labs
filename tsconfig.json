{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
	"types": ["svelte", "node", "mocha"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.svelte",
    "./**/*.d.ts"
  ],
  "exclude": ["node_modules", ".vscode-test"]
}