{
  "name": "vibesec",
  "displayName": "VibeSec",
  "description": "Security scanning extension by Anuwa Labs",
  "version": "1.0.0",
  "publisher": "AnuwaLabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibesec",
          "title": "VibeSec",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "vibesec": [
        {
          "type": "webview",
          "id": "vibesec.dashboardView",
          "name": "Security Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "vibesec.runScan",
        "title": "Run Security Scan",
        "category": "VibeSec"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.56.0",
    "style-loader": "^3.3.3",
    "svelte": "^4.2.19",
    "svelte-loader": "^3.2.3",
    "svelte-preprocess": "^5.1.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  }
}
